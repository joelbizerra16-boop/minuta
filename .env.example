# Copie para .env e preencha com os valores do projeto Neon.
# Nunca commite credenciais reais.

# Banco principal (Neon PostgreSQL apos migracao; SQLite antes da migracao)
# Formato PostgreSQL: postgresql+psycopg2://usuario:senha@host/database?sslmode=require
# Formato SQLite: sqlite:///C:/caminho/para/minuta.db
# Se omitido, o sistema usa automaticamente sqlite:///data/minuta.db
# MINUTA_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Origem SQLite para migracao (somente leitura)
# MINUTA_SQLITE_SOURCE_URL=sqlite:///C:/caminho/para/minuta.db

# Diretorio de dados (XML, PDF). Padrao: data/ na raiz do projeto
# MINUTA_DATA_ROOT=C:/caminho/para/data

# Tamanho do lote na carga ETL (opcional, padrao 500)
# MINUTA_MIGRATION_BATCH_SIZE=500

# Politica de retencao em dias (padrao 8 = hoje + 7 dias)
# MINUTA_RETENTION_DAYS=8

# Limite operacional do banco em bytes (padrao 500 MB)
# MINUTA_DATABASE_LIMIT_BYTES=524288000

# Opcional: URL dedicada para testes de integracao PostgreSQL/Neon
# MINUTA_TEST_POSTGRES_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Backend de persistencia (sql | json | dual)
MINUTA_STORAGE_BACKEND=sql

# Echo SQL (0 | 1)
MINUTA_SQL_ECHO=0
